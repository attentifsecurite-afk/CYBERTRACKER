# Configuration des APIs

# Brave Search API
# Obtenez votre clé sur : https://brave.com/search/api/
VITE_BRAVE_API_KEY=votre_clé_api_brave_ici

# Google Maps API
# Obtenez votre clé sur : https://console.cloud.google.com/google/maps-apis/credentials
# Activez l'API Maps JavaScript dans votre console Google Cloud
VITE_GOOGLE_MAPS_API_KEY=votre_clé_api_google_maps_ici
